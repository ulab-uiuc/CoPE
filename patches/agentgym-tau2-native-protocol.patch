+# variant `native`: tau2's own agent protocol, as InfoPO trains and as `tau2 run`
+# evaluates. The system message is tau2's stock agent prompt (verbatim from InfoPO's
+# training parquet: six lines of instruction and the policy inside <policy> tags --
+# no tool signature table, no response-format block, no extra rules), and the tools
+# are the domain's tools rendered exactly as Qwen2.5's chat template renders a native
+# `tools=` list, so the model sees byte-identical tokens to a native tool-calling
+# request and answers with <tool_call>{"name": ..., "arguments": {...}}</tool_call>.
+# The tool list is environment.get_tools() in tau2's own order and WITHOUT the gym's
+# `done` stop tool: InfoPO's rows carry exactly the domain tools (retail 15, airline
+# 14, telecom 13), and at evaluation the agent cannot end the episode either -- the
+# customer's ###STOP### or the turn budget does. Rendering the block as text instead of
+# passing `tools=` keeps the dataset's tokenized prompt and the rollout's re-rendered
+# generation prompt identical, which the RolloutHandler relies on.
+_NATIVE_PREFIX = (
+    "You are a customer service agent that helps the user according to the policy "
+    "provided below.\nIn each turn you can either:\n- Send a message to the user.\n"
+    "- Make a tool call.\nYou cannot do both at the same time.\n\n"
+    "Try to be helpful and always follow the policy.\n\n<policy>"
+)
+_NATIVE_SUFFIX = "</policy>"
+
+
+def _native_tools_block(tools) -> str:
+    """Qwen2.5 chat-template rendering of a native `tools=` list, as literal text."""
+    import json
+    schemas = [t.openai_schema for t in tools]
+    return (
+        "\n\n# Tools\n\nYou may call one or more functions to assist with the user query.\n\n"
+        "You are provided with function signatures within <tools></tools> XML tags:\n<tools>\n"
+        + "\n".join(json.dumps(sc, ensure_ascii=False) for sc in schemas)
+        + "\n</tools>\n\nFor each function call, return a json object with function name and "
+        "arguments within <tool_call></tool_call> XML tags:\n<tool_call>\n"
+        "{\"name\": <function-name>, \"arguments\": <args-json-object>}\n</tool_call>"
+    )
+
+
+def _native_system_prompt(policy: str, tools) -> str:
+    return f"{_NATIVE_PREFIX}\n{policy}\n{_NATIVE_SUFFIX}" + _native_tools_block(tools)
+
